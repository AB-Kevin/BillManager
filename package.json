{
  "name": "billmanager-file-manager",
  "version": "1.2.1",
  "description": "BillManager - a desktop file manager with preview, tagging, and notes",
  "main": "main.js",
  "author": "",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win",
    "dist:mac": "electron-builder --mac",
    "release": "electron-builder --win --publish always",
    "release:mac": "electron-builder --mac --publish always"
  },
  "devDependencies": {
    "electron": "^43.4.1",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.billmanager.filemanager",
    "productName": "BillManager",
    "files": [
      "main.js",
      "preload.js",
      "renderer/**/*"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "mac": {
      "target": ["dmg", "zip"],
      "icon": "build/icon.icns",
      "identity": "-",
      "hardenedRuntime": false,
      "gatekeeperAssess": false
    },
    "publish": {
      "provider": "github",
      "owner": "AB-Kevin",
      "repo": "BillManager",
      "releaseType": "release"
    }
  },
  "allowScripts": {
    "electron@31.7.7": true,
    "electron-winstaller@5.4.0": true
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "exiftool-vendored": "^37.1.0"
  }
}
