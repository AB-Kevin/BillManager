{
  "name": "billmanager-file-manager",
  "version": "2.2.6",
  "description": "BillManager - a desktop file manager with preview, tagging, and notes",
  "main": "main.js",
  "author": "",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win --publish never"
  },
  "devDependencies": {
    "electron": "^43.4.1",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.billmanager.filemanager",
    "productName": "BillManager",
    "files": [
      "main.js",
      "preload.js",
      "renderer/**/*"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "artifactName": "BillManager-Setup-${version}.${ext}"
    },
    "publish": {
      "provider": "github",
      "owner": "AB-Kevin",
      "repo": "BillManager",
      "releaseType": "release"
    }
  },
  "allowScripts": {
    "electron@31.7.7": true,
    "electron-winstaller@5.4.0": true
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "exiftool-vendored": "^37.1.0",
    "pdf-lib": "^1.17.1"
  }
}
